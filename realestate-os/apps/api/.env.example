# Real Estate OS API - Environment Configuration
# Copy this file to .env and fill in your secrets (DO NOT commit .env)

# Supabase PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Stripe - Test Keys (for development)
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_51234567890abcdefghijklmnopqrstuvwxyz
STRIPE_SECRET_KEY=sk_test_51234567890abcdefghijklmnopqrstuvwxyz
STRIPE_WEBHOOK_SECRET=whsec_test_1234567890abcdefghijklmnopqrstuvwxyz

# API Server
PORT=3001

# Logging
LOG_LEVEL=debug

# Notes on Stripe Keys:
# 1. TEST MODE: Use sk_test_* and pk_test_* for development
# 2. PRODUCTION: Use sk_live_* and pk_live_* (never commit these to code)
# 3. WEBHOOK SECRET: Get from Stripe Dashboard → Developers → Webhooks
# 4. Key Swap: To switch from test to prod, only change .env values in deployment (no code changes needed)
# 5. Events to listen for:
#    - checkout.session.completed: Payment successful
#    - charge.refunded: Refund processed
#    - charge.dispute.created: Chargeback/dispute filed
#    - charge.dispute.closed: Dispute resolved
