{
  "diagram": {
    "type": "architecture",
    "title": "AGENT-OS 13-Layer Complete Architecture",
    "description": "Multi-agent operating system for 789 ventures with dynamic team assembly, Neo4j knowledge graph, and Qdrant memory",
    "nodes": [
      {"id": "layer_1_gov", "type": "layer", "label": "L1: Governance", "sublabel": "Decision authority, risk gates, audit trail", "y": 0},
      {"id": "layer_2_reg", "type": "layer", "label": "L2: Registry", "sublabel": "Entity, capability, venture, authority registries", "y": 1},
      {"id": "layer_3_id", "type": "layer", "label": "L3: Identity & Auth", "sublabel": "Agent identity, capability signing, tool access", "y": 2},
      {"id": "layer_4_orch", "type": "layer", "label": "L4: Orchestrator Kernel", "sublabel": "Plan, select agents, execute async, evaluate, record", "y": 3, "emphasis": true},
      {"id": "layer_5_mem", "type": "layer", "label": "L5: Memory Subsystem", "sublabel": "Qdrant (17K vectors) + Neo4j (20K edges) + execution registry", "y": 4},
      {"id": "layer_6_kg", "type": "layer", "label": "L6: Knowledge Graph", "sublabel": "Neo4j entity resolution, capability coverage, execution history", "y": 5, "emphasis": true},
      {"id": "layer_7_tools", "type": "layer", "label": "L7: Tools & Integrations", "sublabel": "OmniRoute (110 tools), Supabase, Stripe, external APIs", "y": 6},
      {"id": "layer_8_wf", "type": "layer", "label": "L8: Workflow Engine", "sublabel": "State machine, parallel execution, branching, human gates", "y": 7},
      {"id": "layer_9_eval", "type": "layer", "label": "L9: Evaluation", "sublabel": "Discovered → Verified → Tested → Production", "y": 8},
      {"id": "layer_10_obs", "type": "layer", "label": "L10: Observability", "sublabel": "Execution logs, performance metrics, alerts, dashboards", "y": 9},
      {"id": "layer_11_appr", "type": "layer", "label": "L11: Approval & Governance", "sublabel": "Pre-execution checks, escalation rules, compliance", "y": 10},
      {"id": "layer_12_core", "type": "layer", "label": "L12: Domain Agents (16 Core)", "sublabel": "Revenue, Finance, Ops, Research, Sales, Product, Tech, HR", "y": 11},
      {"id": "layer_13_spec", "type": "layer", "label": "L13: Specialist Library", "sublabel": "230+ Agency Agents: sales, tech, ops, finance, marketing, HR, industry-specific", "y": 12, "emphasis": true},

