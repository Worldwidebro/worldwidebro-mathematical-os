<?xml version="1.0" encoding="UTF-8"?>
<!--
WORLDWIDEBRO HOLDINGS — CANONICAL XML KNOWLEDGE MODEL
======================================================

Purpose: Machine-readable schema defining all concepts, registries, relationships, and reasoning
Authority: Master ontology for Company Brain
Version: 1.0
Status: Active

This XML schema defines:
- KNOWLEDGE MODEL: Domains, ontology, vocabulary, thinking levels
- REGISTRIES: Authoritative records for every entity type
- INDEXES: Find mechanisms for key asset types
- WIKI: Human-readable page structure
- RELATIONSHIPS: How entities connect (15+ relationship types)
- ENTERPRISE MODEL: 16-layer architecture
- COMPANY BRAIN: Capabilities and outputs

The 789 ventures are ONE population in this larger graph.
-->

<!DOCTYPE WORLDWIDEBRO_HOLDINGS [
  <!ELEMENT WORLDWIDEBRO_HOLDINGS (KNOWLEDGE_MODEL, REGISTRIES, INDEXES, WIKI, RELATIONSHIPS, ENTERPRISE_MODEL, COMPANY_BRAIN)>
  <!ELEMENT KNOWLEDGE_MODEL (ONTOLOGY, VOCABULARY, THINKING_MODEL)>
  <!ELEMENT ONTOLOGY (DOMAIN*)>
  <!ELEMENT DOMAIN EMPTY>
  <!ELEMENT VOCABULARY (TERM*)>
  <!ELEMENT TERM EMPTY>
  <!ELEMENT THINKING_MODEL (LEVEL*)>
  <!ELEMENT LEVEL EMPTY>
  <!ELEMENT REGISTRIES (REGISTRY*)>
  <!ELEMENT REGISTRY EMPTY>
  <!ELEMENT INDEXES (INDEX*)>
  <!ELEMENT INDEX EMPTY>
  <!ELEMENT WIKI (SECTION*)>
  <!ELEMENT SECTION EMPTY>
  <!ELEMENT RELATIONSHIPS (RELATION*)>
  <!ELEMENT RELATION EMPTY>
  <!ELEMENT ENTERPRISE_MODEL (LAYER*)>
  <!ELEMENT LAYER EMPTY>
  <!ELEMENT COMPANY_BRAIN (INPUTS, REASONING, OUTPUTS)>
  <!ELEMENT INPUTS (INPUT*)>
  <!ELEMENT INPUT EMPTY>
  <!ELEMENT REASONING (CAPABILITY*)>
  <!ELEMENT CAPABILITY EMPTY>
  <!ELEMENT OUTPUTS (OUTPUT*)>
  <!ELEMENT OUTPUT EMPTY>
]>

