    <!-- ========================================================= -->
    <!-- 06. COMPANY BRAIN — Intelligence Layer                   -->
    <!-- ========================================================= -->

    <COMPANY_BRAIN id="CB-001" name="Company Brain"
                   wiki="[[Company Brain]]">

        <DESCRIPTION>
            AI-native intelligence system that reasons about the enterprise,
            discovers opportunities, analyzes risks, and suggests capital allocation.
            Feeds on: registries, wiki, relationships, financial data.
            Produces: insights, opportunities, decisions, recommendations.
        </DESCRIPTION>

        <INPUTS>

            <INPUT type="Registries"
                   source="[[Registries]]"
                   data="Entity records across 27 types"/>

            <INPUT type="Indexes"
                   source="[[Indexes]]"
                   data="Search and discovery mechanisms"/>

            <INPUT type="Wiki"
                   source="[[Worldwidebro Wiki]]"
                   data="Human-readable documentation and knowledge"/>

            <INPUT type="KnowledgeGraph"
                   source="Neo4j"
                   data="20,000+ relationships and causality"/>

            <INPUT type="VectorEmbeddings"
                   source="Qdrant"
                   data="17,000+ concept embeddings"/>

            <INPUT type="FinancialData"
                   source="[[Registries/Revenue]] [[Registries/CashFlow]]"
                   data="OpCo P&Ls, venture performance"/>

            <INPUT type="OperationalData"
                   source="[[Registries/Metrics]]"
                   data="KPIs, performance indicators"/>

            <INPUT type="MarketData"
                   source="[[Registries/Markets]]"
                   data="Market sizes, trends, competition"/>

        </INPUTS>

        <REASONING>

            <CAPABILITY id="CAP-001" name="Entity Classification"
                        wiki="[[AI/Classification]]"
                        description="Classify ventures by sector, OpCo, market, revenue status"/>

            <CAPABILITY id="CAP-002" name="Relationship Traversal"
                        wiki="[[AI/Graph Reasoning]]"
                        description="Navigate enterprise graph: who owns what, who serves whom"/>

            <CAPABILITY id="CAP-003" name="Financial Analysis"
                        wiki="[[AI/Financial Analysis]]"
                        description="Analyze revenue, margins, cash flow, ROIC by OpCo/venture"/>

            <CAPABILITY id="CAP-004" name="Opportunity Discovery"
                        wiki="[[AI/Opportunity Discovery]]"
                        description="Find gaps, white space, consolidation, acquisition targets"/>

            <CAPABILITY id="CAP-005" name="Risk Analysis"
                        wiki="[[AI/Risk Analysis]]"
                        description="Identify concentration risk, competitive threats, dependencies"/>

            <CAPABILITY id="CAP-006" name="Scenario Modeling"
                        wiki="[[AI/Scenario Modeling]]"
                        description="Model outcomes of capital allocation decisions"/>

            <CAPABILITY id="CAP-007" name="Causal Analysis"
                        wiki="[[AI/Causal Analysis]]"
                        description="Understand second-order effects and compounding dynamics"/>

            <CAPABILITY id="CAP-008" name="Valuation"
                        wiki="[[AI/Valuation]]"
                        description="Value ventures, OpCos, acquisition targets using multiple methods"/>

            <CAPABILITY id="CAP-009" name="Capital Allocation"
                        wiki="[[AI/Capital Allocation]]"
                        description="Recommend optimal capital deployment across portfolio"/>

            <CAPABILITY id="CAP-010" name="Deal Analysis"
                        wiki="[[AI/Deal Analysis]]"
                        description="Evaluate M&A targets, terms, synergies, integration risks"/>

        </REASONING>

        <OUTPUTS>

            <OUTPUT type="Insight"
                    wiki="[[Outputs/Insight]]"
                    description="What we learned about the enterprise or market"/>

            <OUTPUT type="Opportunity"
                    wiki="[[Outputs/Opportunity]]"
                    description="Identified opportunity for build, buy, or invest"/>

            <OUTPUT type="Risk"
                    wiki="[[Outputs/Risk]]"
                    description="Identified risk requiring mitigation"/>

            <OUTPUT type="Decision"
                    wiki="[[Outputs/Decision]]"
                    description="Recommendation on capital allocation or strategic choice"/>

