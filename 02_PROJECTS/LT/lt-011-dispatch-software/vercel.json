{
  "version": 2,
  "builds": [
    {
      "src": "services/api/src/server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "apps/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "services/api/src/server.ts"
    },
    {
      "src": "/apps/(.*)",
      "dest": "apps/$1"
    }
  ]
}
