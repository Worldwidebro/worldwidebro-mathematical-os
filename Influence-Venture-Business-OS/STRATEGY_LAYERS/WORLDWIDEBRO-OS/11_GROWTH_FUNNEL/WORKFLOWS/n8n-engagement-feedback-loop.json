{
  "name": "Engagement Feedback Loop (Daily)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 24 }] }
      },
      "id": "cron-daily",
      "name": "Every 24h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "gf_content_assets",
        "filters": {
          "conditions": [{ "keyName": "status", "keyValue": "published" }]
        }
      },
      "id": "fetch-published",
      "name": "Fetch Published Assets",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [480, 300],
      "notes": "Configure Supabase credentials"
    },
    {
      "parameters": {
        "command": "echo 'Pull platform analytics here — YouTube/IG/TikTok API nodes'"
      },
      "id": "pull-analytics",
      "name": "Pull Platform Analytics",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [720, 300],
      "notes": "Replace with HTTP nodes per platform"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.views}}",
              "operation": "largerEqual",
              "value2": 5000
            }
          ]
        }
      },
      "id": "if-viral",
      "name": "TOF Viral?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "command": "python3 /Users/acebless/Documents/WORLDWIDEBRO-OS/11_GROWTH_FUNNEL/SCRIPTS/generate_funnel_content.py --venture-id={{$json.venture_id}} --stages mof"
      },
      "id": "gen-mof-expansion",
      "name": "Generate MOF Expansion",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "gf_funnel_events",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "venture_id", "fieldValue": "={{$json.venture_id}}" },
            { "fieldId": "event_type", "fieldValue": "tof_viral" },
            { "fieldId": "payload", "fieldValue": "={{$json}}" }
          ]
        }
      },
      "id": "log-event",
      "name": "Log Funnel Event",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1200, 400]
    }
  ],
  "connections": {
    "Every 24h": { "main": [[{ "node": "Fetch Published Assets", "type": "main", "index": 0 }]] },
    "Fetch Published Assets": { "main": [[{ "node": "Pull Platform Analytics", "type": "main", "index": 0 }]] },
    "Pull Platform Analytics": { "main": [[{ "node": "TOF Viral?", "type": "main", "index": 0 }]] },
    "TOF Viral?": {
      "main": [
        [{ "node": "Generate MOF Expansion", "type": "main", "index": 0 }],
        [{ "node": "Log Funnel Event", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "description": "Daily analytics pull → rank → promote TOF winners to MOF. Threshold: 5000 views (edit in IF node)."
  }
}
