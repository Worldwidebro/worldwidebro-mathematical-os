# Rendered to config.hcl by ../../scripts/render-openbao-config.sh

ui = true

log_level = "info"

listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = true
}

api_addr     = "http://127.0.0.1:8200"
cluster_addr = "http://127.0.0.1:8201"

storage "postgresql" {
  connection_url = "postgres://${DB_USER}:${DB_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable"
  table            = "openbao_kv_store"
  max_parallel     = "4"
  max_idle_conns   = "4"
}

disable_mlock = true

default_lease_ttl = "168h"
max_lease_ttl     = "720h"

