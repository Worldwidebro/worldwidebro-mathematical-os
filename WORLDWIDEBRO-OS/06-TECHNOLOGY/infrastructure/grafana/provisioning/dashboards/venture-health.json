      "pluginVersion": "8.0.0",
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT venture_id, venture_name, sector, current_max_phase, completion_percentage, completed_skills, blocked_skills FROM (SELECT vsr.venture_id, v.venture_name, v.sector, MAX(vsr.skill_phase) as current_max_phase, ROUND(COUNT(CASE WHEN vsr.status='completed' THEN 1 END)::FLOAT / NULLIF(COUNT(*), 0) * 100, 2) as completion_percentage, COUNT(CASE WHEN vsr.status='completed' THEN 1 END) as completed_skills, COUNT(CASE WHEN vsr.status='blocked' THEN 1 END) as blocked_skills FROM venture_skill_roadmap vsr LEFT JOIN ventures v ON vsr.venture_id = v.venture_id GROUP BY vsr.venture_id, v.venture_name, v.sector) ORDER BY completion_percentage DESC",
          "refId": "A"
        }
      ],
      "title": "All Ventures - Health Summary",
      "type": "table"
    },
