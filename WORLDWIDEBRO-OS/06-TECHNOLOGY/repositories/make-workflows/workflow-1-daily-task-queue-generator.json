{
  "name": "Daily Task Queue Generator",
  "description": "Runs at 8am UTC daily. Queries top 50 ventures, generates OSINT tasks for contacts, creates scoring tasks for incomplete ventures.",
  "trigger": "schedule",
  "trigger_config": {
    "type": "daily",
    "time": "08:00",
    "timezone": "UTC"
  },
  "steps": [
    {
      "id": "step_1",
      "name": "Query Graphify for top 50 ventures",
      "action": "http_request",
      "config": {
        "url": "http://localhost:9024/mcp/list_nodes",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "node_type": "venture",
          "limit": 50,
          "sort_by": "revenue_potential",
          "order": "DESC"
        }
      },
      "output": "top_ventures"
    },
    {
      "id": "step_2",
      "name": "Get all contacts for matching",
      "action": "supabase_query",
      "config": {
        "table": "contacts",
        "columns": ["id", "name", "skills", "warmth_score"],
        "limit": 100
      },
      "output": "all_contacts"
    },
    {
      "id": "step_3",
      "name": "For each venture: generate OSINT tasks",
      "action": "loop",
      "config": {
        "iterate_over": "top_ventures.nodes",
        "loop_body": [
          {
            "step_id": "step_3_1",
            "name": "Get existing OSINT coverage",
            "action": "supabase_query",
            "config": {
              "table": "aoc_tasks",
              "columns": ["contact_id"],
              "filter": {
                "venture_id": "{{venture.id}}",
                "task_type": "osint_contact",
                "status": ["complete", "executing"]
              }
            },
            "output": "covered_contacts"
          },
          {
            "step_id": "step_3_2",
            "name": "Find uncovered contacts",
            "action": "javascript",
            "config": {
              "script": "const uncovered = all_contacts.filter(c => !covered_contacts.some(x => x.contact_id === c.id)); return uncovered;"
            },
            "output": "uncovered_contacts"
          },
          {
            "step_id": "step_3_3",
            "name": "Create OSINT task for each uncovered contact",
            "action": "supabase_insert",
            "config": {
              "table": "aoc_tasks",
              "data": {
                "task_type": "osint_contact",
                "venture_id": "{{venture.id}}",
                "contact_id": "{{contact.id}}",
                "assigned_agent": "mac_studio",
                "status": "queued",
                "priority": 7,
                "payload": {
                  "contact_name": "{{contact.name}}",
                  "venture_id": "{{venture.id}}"
                },
                "due_at": "{{now() + 1 day}}"
              }
            },
            "loop_over": "uncovered_contacts",
            "output": "osint_tasks_created"
          }
        ]
      }
    },
    {
      "id": "step_4",
      "name": "Query incomplete ventures for scoring",
      "action": "supabase_query",
      "config": {
        "table": "ventures",
        "columns": ["id", "name", "sector"],
        "filter": {
          "completeness_score": {
            "operator": "<",
            "value": 80
          }
        },
        "limit": 50
      },
      "output": "incomplete_ventures"
    },
    {
      "id": "step_5",
      "name": "Create scoring tasks for incomplete ventures",
      "action": "loop",
      "config": {
        "iterate_over": "incomplete_ventures.data",
        "loop_body": [
          {
            "step_id": "step_5_1",
            "name": "Check if already scored today",
            "action": "supabase_query",
            "config": {
              "table": "aoc_tasks",
              "filter": {
                "venture_id": "{{venture.id}}",
                "task_type": "score_venture",
                "created_at": {
                  "operator": ">",
                  "value": "{{now() - 24 hours}}"
                }
              }
            },
            "output": "recent_scoring_tasks"
          },
          {
            "step_id": "step_5_2",
            "name": "Create task if not recently scored",
            "action": "javascript",
            "config": {
              "script": "return recent_scoring_tasks.length === 0;"
            },
            "output": "should_create_task"
          },
          {
            "step_id": "step_5_3",
            "name": "Insert scoring task",
            "action": "supabase_insert",
            "config": {
              "table": "aoc_tasks",
              "data": {
                "task_type": "score_venture",
                "venture_id": "{{venture.id}}",
                "assigned_agent": "mac_studio",
                "status": "queued",
                "priority": 6,
                "payload": {
                  "venture_id": "{{venture.id}}",
                  "venture_name": "{{venture.name}}"
                },
                "due_at": "{{now() + 2 days}}"
              }
            },
            "condition": "should_create_task",
            "output": "scoring_task_created"
          }
        ]
      }
    },
    {
      "id": "step_6",
      "name": "Count tasks created",
      "action": "javascript",
      "config": {
        "script": "const osintCount = osint_tasks_created ? osint_tasks_created.length : 0; const scoringCount = scoring_task_created ? scoring_task_created.length : 0; return {total: osintCount + scoringCount, osint: osintCount, scoring: scoringCount};"
      },
      "output": "task_summary"
    },
    {
      "id": "step_7",
      "name": "Send notification email",
      "action": "gmail_send",
      "config": {
        "to": "winnerscirclewcllc@gmail.com",
        "subject": "Daily Queue Generated: {{task_summary.total}} tasks queued",
        "body": "OSINT tasks: {{task_summary.osint}}\nScoring tasks: {{task_summary.scoring}}\n\nQueue ready for execution."
      }
    }
  ],
  "error_handling": {
    "on_error": "send_alert",
    "alert_email": "winnerscirclewcllc@gmail.com"
  }
}
