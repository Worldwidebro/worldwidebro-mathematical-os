# Step 4: Environment Variables
# Copy to .env.local and fill in your keys

# Stripe (for stripe-mcp on port 9010)
STRIPE_API_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# GitHub (for github-mcp on port 9011)
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
GITHUB_ORG=Worldwidebro

# PostgreSQL (for postgres-mcp on port 9012)
POSTGRES_URL=postgresql://user:password@localhost:5432/ventures

# Supabase (for supabase-mcp on port 9013)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Temporal (for workflow orchestration on port 7233)
TEMPORAL_NAMESPACE=default
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233

# Dashboard
VITE_API_URL=http://localhost:9002
VITE_TEMPORAL_URL=http://localhost:7233
