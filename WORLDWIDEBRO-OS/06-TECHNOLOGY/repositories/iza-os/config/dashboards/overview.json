  "panels": [
    {
      "type": "stat",
      "title": "Prometheus up",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "id": 1,
      "targets": [
        {"expr": "up{job=\"prometheus\"}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto", "colorMode": "value"},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}], "color": {"mode": "thresholds"}}}
    },
    {
      "type": "timeseries",
      "title": "Prometheus HTTP request rate",
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8},
      "id": 2,
      "targets": [
        {"expr": "rate(prometheus_http_requests_total[1m])", "refId": "A", "legendFormat": "{{handler}}", "datasource": {"type": "prometheus", "uid": "prometheus"}}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Scrape targets",
      "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4},
      "id": 3,
      "targets": [
        {"expr": "count(up)", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"}
    },
    {
      "type": "logs",
      "title": "Loki — recent entries",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 10},
      "id": 4,
      "targets": [
        {"expr": "{job=~\".+\"}", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}
      ],
      "options": {"showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending"}
    }
  ],
