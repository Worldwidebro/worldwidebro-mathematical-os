{
  "name": "Weekly Growth via Webhook (n8n Cloud)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * 1" }] }
      },
      "id": "cron-mon",
      "name": "Mon 9AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/run-weekly",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Funnel-Secret", "value": "={{$env.N8N_WEBHOOK_SECRET}}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"venture_id\": \"1d84705c-8ebd-4c0c-83cf-cf383951b7bb\", \"day\": \"monday\"}"
      },
      "id": "http-weekly",
      "name": "POST Local Webhook Runner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "notes": "Replace URL with Tailscale host if n8n is remote from Mac runner"
    }
  ],
  "connections": {
    "Mon 9AM": { "main": [[{ "node": "POST Local Webhook Runner", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/New_York" },
  "meta": {
    "description": "For n8n Cloud: run SCRIPTS/n8n_webhook_runner.py on Mac first. Duplicate cron nodes for Tue-Sun with day field."
  }
}
