{
  "version": 1,
  "name": "venture-media-factory",
  "paths": {
    "docs": "/Users/acebless/Documents",
    "funnel_root": "/Users/acebless/Documents/WORLDWIDEBRO-OS/11_GROWTH_FUNNEL",
    "output_dir": "/Users/acebless/Documents/moneyprinter-output",
    "venture_batch": "/Users/acebless/Documents/WORLDWIDEBRO-OS/11_GROWTH_FUNNEL/REGISTRY/construction-batch.json"
  },
  "defaults": {
    "priority_mode": "round_robin",
    "funnel_stage_auto": true,
    "render_video": false,
    "higgsfield_scenes": false,
    "higgsfield_model": "nano_banana_2",
    "opus_clip_after_render": true,
    "notify_n8n": false,
    "sync_supabase_after_run": false
  },
  "funnel_stage_by_weekday": {
    "monday": "tof",
    "tuesday": "tof",
    "wednesday": "mof",
    "thursday": "mof",
    "friday": "bof",
    "saturday": "analytics",
    "sunday": "prep"
  },
  "n8n": {
    "webhook_base": "http://127.0.0.1:8765",
    "endpoints": {
      "weekly": "/run-weekly",
      "batch": "/run-batch",
      "orchestrator": "/run-orchestrator",
      "opus": "/run-opus-clip",
      "sync": "/sync-supabase",
      "posted": "/funnel-posted"
    },
    "secret_env": "N8N_WEBHOOK_SECRET"
  },
  "higgsfield": {
    "enabled_env": "HIGGSFIELD_ENABLED",
    "cli": "higgsfield",
    "scene_model_image": "nano_banana_2",
    "scene_model_video": "seedance_2_0",
    "aspect_ratio": "9:16"
  },
  "opus": {
    "enabled_env": "OPUS_API_KEY",
    "note": "Manual or API — set OPUS_API_KEY when available"
  },
  "layers": {
    "intelligence": ["content_brain.py", "Supabase/SQLite"],
    "strategy": ["weekly_funnel_runner.py", "generate_funnel_content.py"],
    "production": ["venture_script_engine.py", "venture_video_pipeline.py", "higgsfield CLI"],
    "viral": ["Opus Clip", "publish_queue"],
    "orchestration": ["MASTER_ORCHESTRATOR.py", "n8n"]
  }
}
