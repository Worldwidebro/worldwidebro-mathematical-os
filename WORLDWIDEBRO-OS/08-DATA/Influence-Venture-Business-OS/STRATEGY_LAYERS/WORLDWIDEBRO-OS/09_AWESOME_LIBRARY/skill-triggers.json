  "phase_flow": {
    "phase_1": {
      "name": "Setup & Environment",
      "trigger": "New project or onboarding",
      "order": ["getting-started", "init"],
      "outcomes": "Development environment ready, permissions configured"
    },
    "phase_2": {
      "name": "Discovery & Research",
      "trigger": "Starting work on venture",
      "order": ["market-research", "deep-research", "ask-docs", "socraticode:codebase-exploration"],
      "outcomes": "Problem understood, market validated, research complete"
    },
    "phase_3": {
      "name": "Ideation & Strategy",
      "trigger": "Research complete, ready to plan",
      "order": ["superpowers:brainstorming"],
      "outcomes": "Strategy aligned, approach decided"
    },
    "phase_4": {
      "name": "Planning & Architecture",
      "trigger": "Strategy complete, ready to build",
      "order": ["plan", "planning-with-files"],
      "outcomes": "Architecture documented, plan complete"
    },
    "phase_5": {
      "name": "Specification & Design",
      "trigger": "Plan complete, ready for detailed specs",
      "order": ["design-task"],
      "outcomes": "Detailed specs ready, design approved"
    },
    "phase_6": {
      "name": "Core Implementation",
      "trigger": "Specs ready, implementation approved",
      "order": ["feature-dev", "run", "orchestrate"],
      "outcomes": "Features implemented, app running"
    },
    "phase_7": {
      "name": "Testing & Verification",
      "trigger": "Implementation complete, ready for QA",
      "order": ["verify", "code-review", "security-review"],
      "outcomes": "Code approved, security verified"
    },
    "phase_10": {
      "name": "Release & Deployment",
      "trigger": "Feature complete and approved, ready for release",
      "order": ["prp-commit", "prp-pr", "github-ops"],
      "outcomes": "Code merged, pipeline triggered"
    },
    "phase_11": {
      "name": "Growth & Marketing",
      "trigger": "Feature released, ready to promote",
      "order": ["investor-outreach"],
      "outcomes": "Marketing live, user acquisition started"
    },
    "phase_12": {
      "name": "Operations & Maintenance",
      "trigger": "Feature in production, need ongoing ops",
      "order": ["loop", "schedule", "automation-audit-ops"],
      "outcomes": "Automation running, monitoring active"
    }
  },
