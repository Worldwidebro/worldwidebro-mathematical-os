# =============================================================================
# Standard .gitignore for Civilization OS Ventures
# =============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
*.env

# Build outputs
dist/
build/
.next/
out/
*.min.js
*.min.css
*.tsbuildinfo

# Logs
logs/
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.iml
*.swp
*.swo

# Testing
coverage/
.nyc_output/
*.lcov

# Temporary files
tmp/
temp/
*.tmp
*.bak
.vercel
