{
  "version": "1.0.0",
  "description": "Baseline cognitive UX decision rules for venture sites",
  "rules": [
    {
      "id": "high-risk-friction",
      "when": {
        "risk_score_gte": 0.7
      },
      "then": {
        "inject_confirmation_step": true,
        "show_risk_copy": true,
        "guidance_level": "high"
      }
    },
    {
      "id": "low-confidence-simplify",
      "when": {
        "confidence_score_lte": 0.35
      },
      "then": {
        "disclosure_level": "compressed",
        "show_contextual_help": true,
        "prioritize_next_best_action": true
      }
    },
    {
      "id": "returning-user-speed-up",
      "when": {
        "returning_user": true,
        "confidence_score_gte": 0.65,
        "risk_score_lte": 0.4
      },
      "then": {
        "disclosure_level": "default",
        "prefill_known_fields": true,
        "prioritize_resume_flow": true
      }
    },
    {
      "id": "repeated-form-errors-recovery",
      "when": {
        "form_error_count_gte": 3
      },
      "then": {
        "switch_to_guided_form_mode": true,
        "offer_human_support": true,
        "guidance_level": "high"
      }
    }
  ]
}

