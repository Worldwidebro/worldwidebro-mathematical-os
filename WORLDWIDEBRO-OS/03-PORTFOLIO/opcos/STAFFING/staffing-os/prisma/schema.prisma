// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Worker {
  id            String      @id @default(cuid())
  fullName      String
  phone         String      @unique
  email         String      @unique
  skills        String[]    // e.g., ["electrical", "hvac", "general-labor"]
  hourlyRate    Float       // What we pay them
  status        String      @default("active") // active, inactive, suspended
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  placements    Placement[]
  timesheets    Timesheet[]

  @@map("workers")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  contact   String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]

  @@map("clients")
}

model Job {
  id         String      @id @default(cuid())
  title      String      // e.g., "HVAC Installation"
  location   String
  skillsNeeded String[]   // e.g., ["hvac"]
  billRate   Float       // What client pays
  duration   String      // e.g., "4 hours", "2 days"
  status     String      @default("open") // open, assigned, in-progress, completed
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  placements Placement[]

  @@map("jobs")
}

model Placement {
  id        String    @id @default(cuid())
  workerId  String
  worker    Worker    @relation(fields: [workerId], references: [id])
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id])
  status    String    @default("assigned") // assigned, in-progress, completed
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  timesheets Timesheet[]

  @@unique([workerId, jobId])
  @@map("placements")
}

model Timesheet {
  id           String    @id @default(cuid())
  workerId     String
  worker       Worker    @relation(fields: [workerId], references: [id])
  placementId  String
  placement    Placement @relation(fields: [placementId], references: [id])
  date         DateTime
  hours        Float
  notes        String?
  approved     Boolean   @default(false)
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("timesheets")
}

model Commission {
  id          String    @id @default(cuid())
  referralId  String    // From Worldwidebro contacts
  serviceType String    // HVAC, Electrical, etc.
  amount      Float
  status      String    @default("pending") // pending, paid, disputed
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("commissions")
}
