{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Schema",
  "description": "Contract for all agent definitions across CivilizationOS",
  "type": "object",
  "required": ["agent_id", "agent_type", "role", "capabilities", "permissions"],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique agent identifier (e.g., orch-712-main, venture-bw-001, risk-monitor-main)"
    },
    "agent_type": {
      "type": "string",
      "enum": ["orchestrator", "venture", "risk"],
      "description": "One of three agent types in the system"
    },
    "role": {
      "type": "string",
      "description": "Human-readable role (e.g., Master Orchestrator, Venture Manager, Risk Monitor)"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of capabilities this agent can execute (query_ventures, make_decisions, validate_risk, etc.)"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["read_ventures", "read_graph", "read_metrics", "write_events", "write_state", "execute_workflows", "allocate_capital", "escalate_human"]
      },
      "description": "Explicit permissions for accessing systems"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["langgraph", "temporal", "native"],
          "description": "Execution framework (LangGraph for agents, Temporal for workflows)"
        },
        "model": {
          "type": "string",
          "description": "LLM model ID (e.g., claude-opus-4-8, claude-sonnet-4-6)"
        },
        "max_tool_calls": {
          "type": "integer",
          "default": 10
        },
        "reasoning_timeout_ms": {
          "type": "integer",
          "default": 30000
        }
      }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "kafka_consumer_group": {
          "type": "string"
        },
        "kafka_topics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "postgres_connection": {
          "type": "string"
        },
        "redis_connection": {
          "type": "string"
        },
        "neo4j_connection": {
          "type": "string"
        }
      }
    }
  }
}
