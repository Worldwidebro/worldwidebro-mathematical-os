{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entity Registry",
  "description": "Ventures and sectors for AI Boss OS — loaded from ventures-master.csv",
  "type": "object",
  "required": ["version", "counts", "sectors", "ventures"],
  "properties": {
    "version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "properties": {
        "ventures_csv": { "type": "string" },
        "sector_agents": { "type": "string" },
        "sector_mapping": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "required": ["ventures", "sectors"],
      "properties": {
        "ventures": { "type": "integer", "minimum": 1 },
        "sectors": { "type": "integer", "minimum": 1 },
        "relationships": { "type": "integer", "minimum": 0 }
      }
    },
    "sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sector_code", "name", "economic_layer", "agent_id"],
        "properties": {
          "sector_code": { "type": "string", "pattern": "^[A-Z]{2,6}$" },
          "name": { "type": "string" },
          "economic_layer": { "type": "string" },
          "agent_id": { "type": "string" },
          "dispatch_status": { "type": "string", "enum": ["active", "planned"] }
        }
      }
    },
    "ventures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["venture_id", "name", "sector_code", "stage", "status"],
        "properties": {
          "venture_id": { "type": "string" },
          "name": { "type": "string" },
          "sector_code": { "type": "string" },
          "sector_slug": { "type": "string" },
          "stage": { "type": "string" },
          "status": { "type": "string" },
          "repository_url": { "type": ["string", "null"], "format": "uri" },
          "github_slug": { "type": ["string", "null"] },
          "revenue_ytd": { "type": ["string", "null"] },
          "costs_mom": { "type": ["string", "null"] },
          "staff_count": { "type": ["string", "null"] },
          "blockers": { "type": ["string", "null"] },
          "next_action": { "type": ["string", "null"] }
        }
      }
    }
  }
}
