{
  "name": "Capability Request Flow",
  "description": "Routes capability requests from ventures to departments to agents. Logs to Supabase, queries Neo4j, assigns agent, updates dashboard, notifies via Slack.",
  "tags": ["IZA-OS", "Phase-3", "Capability-Routing"],
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "capability-request",
        "responseMode": "onReceived"
      },
      "id": "webhook-receive",
      "name": "Webhook: Capability Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "ventures_requesting",
        "columns": "venture_id,capability_required,priority,context,status,created_at",
        "values": "={{ { venture_id: $json.venture_id, capability_required: $json.capability_required, priority: $json.priority || 'medium', context: JSON.stringify($json.context || {}), status: 'pending', created_at: 'NOW()' } }}"
      },
      "id": "log-request",
      "name": "Log Request to Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "query": "MATCH (d:Department)-[:PROVIDES_CAPABILITY]->(c:Capability {name: $capability}) RETURN d.id as department_id, d.name as department_name LIMIT 1",
        "parameters": "={{ { capability: $json.capability_required } }}"
      },
      "id": "query-department",
      "name": "Neo4j: Find Department",
      "type": "n8n-nodes-base.neo4j",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "condition": "isEmpty",
              "value1": "={{ $json.body[0] }}"
            }
          ],
          "combinator": "or"
        }
      },
      "id": "check-dept-found",
      "name": "Department Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "query": "MATCH (d:Department {id: $dept_id})-[:HAS_AGENT]->(a:Agent) WHERE a.status = 'available' RETURN a.id as agent_id, a.name as agent_name, a.expertise as expertise LIMIT 1",
        "parameters": "={{ { dept_id: $json.body[0].department_id } }}"
      },
      "id": "query-agent",
      "name": "Neo4j: Find Available Agent",
      "type": "n8n-nodes-base.neo4j",
      "typeVersion": 1,
      "position": [900, 100]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "condition": "isEmpty",
              "value1": "={{ $json.body[0] }}"
            }
          ],
          "combinator": "or"
        }
      },
      "id": "check-agent-found",
      "name": "Agent Available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 100]
    },
    {
      "parameters": {
        "operation": "update",
        "schema": "public",
        "table": "ventures_requesting",
        "where": "venture_id = $1",
        "updateKey": "venture_id",
        "columns": "assigned_agent_id,assigned_department_id,status,updated_at",
        "values": "={{ { assigned_agent_id: $json.body[0].agent_id, assigned_department_id: $json.body[0].department_id, status: 'assigned', updated_at: 'NOW()' } }}"
      },
      "id": "update-db-assigned",
      "name": "Supabase: Update Assignment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1200, 100]
    },
    {
      "parameters": {
        "url": "http://localhost:3000/api/dashboard/request/update",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "request_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "status",
              "value": "'assigned'"
            },
            {
              "name": "assigned_agent_id",
              "value": "={{ $json.body[0].agent_id }}"
            }
          ]
        }
      },
      "id": "http-dashboard-update",
      "name": "HTTP: Update Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1350, 100]
    },
    {
      "parameters": {
        "channel": "#iza-os-assignments",
        "text": "✅ Capability Request Assigned\n*Venture:* {{ $json.venture_id }}\n*Capability:* {{ $json.capability_required }}\n*Agent:* {{ $json.body[0].agent_name }}\n*Priority:* {{ $json.priority }}\n*Request ID:* {{ $json.id }}"
      },
      "id": "slack-notify-agent",
      "name": "Slack: Notify Agent",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1500, 100]
    },
    {
      "parameters": {
        "responseMode": "responseNode",
        "body": "={{ { request_id: $json.id, assigned_agent_id: $json.body[0].agent_id, status: 'assigned', timestamp: new Date().toISOString() } }}"
      },
      "id": "response-success",
      "name": "Response: Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1650, 100]
    },
    {
      "parameters": {
        "operation": "update",
        "schema": "public",
        "table": "ventures_requesting",
        "where": "venture_id = $1",
        "updateKey": "venture_id",
        "columns": "status,escalation_reason,updated_at",
        "values": "={{ { status: 'escalation_pending', escalation_reason: 'no_available_agents', updated_at: 'NOW()' } }}"
      },
      "id": "update-db-escalate-agents",
      "name": "Supabase: Mark Escalation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1200, 450]
    },
    {
      "parameters": {
        "url": "http://localhost:5678/webhook/escalation-flow",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "escalation_type",
              "value": "'no_available_agents'"
            },
            {
              "name": "request_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "department_id",
              "value": "={{ $json.body[0].department_id }}"
            },
            {
              "name": "venture_id",
              "value": "={{ $json.venture_id }}"
            }
          ]
        }
      },
      "id": "http-escalation-trigger-agents",
      "name": "HTTP: Trigger Escalation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1350, 450]
    },
    {
      "parameters": {
        "operation": "update",
        "schema": "public",
        "table": "ventures_requesting",
        "where": "venture_id = $1",
        "updateKey": "venture_id",
        "columns": "status,escalation_reason,updated_at",
        "values": "={{ { status: 'escalation_pending', escalation_reason: 'capability_not_found', updated_at: 'NOW()' } }}"
      },
      "id": "update-db-escalate-dept",
      "name": "Supabase: Mark Escalation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1200, 750]
    },
    {
      "parameters": {
        "url": "http://localhost:5678/webhook/escalation-flow",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "escalation_type",
              "value": "'capability_not_found'"
            },
            {
              "name": "request_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "capability",
              "value": "={{ $json.capability_required }}"
            },
            {
              "name": "venture_id",
              "value": "={{ $json.venture_id }}"
            }
          ]
        }
      },
      "id": "http-escalation-trigger-dept",
      "name": "HTTP: Trigger Escalation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1350, 750]
    },
    {
      "parameters": {
        "channel": "#iza-os-errors",
        "text": "⚠️ Capability Request Escalated\n*Type:* {{ $json.escalation_type }}\n*Venture:* {{ $json.venture_id }}\n*Capability:* {{ $json.capability_required }}\n*Reason:* {{ $json.escalation_reason }}\n*Request ID:* {{ $json.id }}"
      },
      "id": "slack-log-escalation",
      "name": "Slack: Log Escalation",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1500, 600]
    }
  ],
  "connections": {
    "webhook-receive": {
      "main": [[{"node": "log-request", "type": "main", "index": 0}]]
    },
    "log-request": {
      "main": [[{"node": "query-department", "type": "main", "index": 0}]]
    },
    "query-department": {
      "main": [[{"node": "check-dept-found", "type": "main", "index": 0}]]
    },
    "check-dept-found": {
      "main": [
        [{"node": "query-agent", "type": "main", "index": 0}],
        [{"node": "update-db-escalate-dept", "type": "main", "index": 0}]
      ]
    },
    "query-agent": {
      "main": [[{"node": "check-agent-found", "type": "main", "index": 0}]]
    },
    "check-agent-found": {
      "main": [
        [{"node": "update-db-assigned", "type": "main", "index": 0}],
        [{"node": "update-db-escalate-agents", "type": "main", "index": 0}]
      ]
    },
    "update-db-assigned": {
      "main": [[{"node": "http-dashboard-update", "type": "main", "index": 0}]]
    },
    "http-dashboard-update": {
      "main": [[{"node": "slack-notify-agent", "type": "main", "index": 0}]]
    },
    "slack-notify-agent": {
      "main": [[{"node": "response-success", "type": "main", "index": 0}]]
    },
    "update-db-escalate-agents": {
      "main": [[{"node": "http-escalation-trigger-agents", "type": "main", "index": 0}]]
    },
    "http-escalation-trigger-agents": {
      "main": [[{"node": "slack-log-escalation", "type": "main", "index": 0}]]
    },
    "update-db-escalate-dept": {
      "main": [[{"node": "http-escalation-trigger-dept", "type": "main", "index": 0}]]
    },
    "http-escalation-trigger-dept": {
      "main": [[{"node": "slack-log-escalation", "type": "main", "index": 0}]]
    }
  }
}
