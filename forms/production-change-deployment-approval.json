    "description": {"type": "string", "label": "What's Changing", "required": true, "max_length": 1000},
    "impact_level": {"type": "enum", "label": "Impact Level", "required": true, "values": ["Critical", "High", "Medium", "Low"]},
    "rollback_plan": {"type": "string", "label": "Rollback Plan", "required": true, "max_length": 500},
    "requested_date": {"type": "string", "label": "Requested Date", "required": true, "format": "YYYY-MM-DD"}
